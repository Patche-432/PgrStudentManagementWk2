@{
    ViewData["Title"] = "Research Activities";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Research Activities</h1>
            <p class="text-muted mb-0">Research activities recorded for students.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Student Number</th>
                            <th>Activity Type</th>
                            <th>Title</th>
                            <th>Activity Date</th>
                            <th>Tags</th>
                            <th>Conference Name</th>
                            <th>Location</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var activity in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">
                                    @activity.StudentNumber
                                </td>

                                <td>
                                    @activity.ActivityType
                                </td>

                                <td>
                                    @activity.Title
                                </td>

                                <td>
                                    @activity.ActivityDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @(activity.Tags?.Any() == true
                                        ? string.Join(", ", activity.Tags)
                                        : "None")
                                </td>

                                <td>
                                    @(activity.Details?.ContainsKey("conferenceName") == true
                                        ? activity.Details["conferenceName"]
                                        : "-")
                                </td>

                                <td>
                                    @(activity.Details?.ContainsKey("location") == true
                                        ? activity.Details["location"]
                                        : "-")
                                </td>

                                <td class="text-end pe-3">
                                    <a asp-action="Details"
                                       asp-route-id="@activity.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>