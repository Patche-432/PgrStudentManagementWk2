@model IEnumerable<AcademicSupervisor>

@{
    ViewData["Title"] = "Academic Supervisors";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Academic Supervisors</h1>
            <p class="text-muted mb-0">Supervisors, their employment type, training status and eligible roles.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <span class="fs-5">+</span> Create Academic Supervisor
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            No Academic Supervisors found
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Staff Number</th>
                                <th>Full Name</th>
                                <th>Employment Type</th>
                                <th>Training</th>
                                <th>Eligible Roles</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var supervisor in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">@supervisor.StaffNumber</td>
                                    <td>@supervisor.FullName</td>
                                    <td>@supervisor.EmploymentType</td>
                                    <td>
                                        @if (supervisor.TrainingCompleted)
                                        {
                                            <span class="badge bg-success">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Not completed</span>
                                        }
                                    </td>
                                    <td>@(supervisor.EligibleRoles.Any() ? string.Join(", ", supervisor.EligibleRoles) : "None")</td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Details"
                                           asp-route-staffNumber="@supervisor.StaffNumber"
                                           class="btn btn-outline-primary btn-sm"
                                           title="View Academic Supervisor Details (W4-UC03)">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
