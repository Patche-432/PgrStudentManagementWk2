@model AcademicSupervisor

@{
    ViewData["Title"] = "Create Academic Supervisor";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h2 mb-1">Create Academic Supervisor</h1>
            <p class="text-muted mb-0">Fields marked * are required.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            <div asp-validation-summary="All" class="text-danger mb-0"></div>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="StaffNumber" class="form-label fw-bold">Staff Number *</label>
                        <input asp-for="StaffNumber" class="form-control" />
                        <span asp-validation-for="StaffNumber" class="text-danger"></span>
                        <div class="form-text">External supervisors need a unique staff number too.</div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="FirstName" class="form-label fw-bold">First Name *</label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="LastName" class="form-label fw-bold">Last Name *</label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EmploymentType" class="form-label fw-bold">Employment Type *</label>
                        <select asp-for="EmploymentType"
                                asp-items="Html.GetEnumSelectList<SupervisorEmploymentType>()"
                                class="form-select">
                            <option value="">Select employment type</option>
                        </select>
                        <span asp-validation-for="EmploymentType" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="EmailAddress" class="form-label fw-bold">Email Address</label>
                        <input asp-for="EmailAddress" class="form-control" />
                        <span asp-validation-for="EmailAddress" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="TrainingCompleted" class="form-check-input" />
                        <label asp-for="TrainingCompleted" class="form-check-label">Supervisor training completed</label>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create Supervisor</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
